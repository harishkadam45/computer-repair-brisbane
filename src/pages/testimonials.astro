---
/**
 * Reviews page at /testimonials/.
 *
 * The important constraint here: this page must not invent reviews. There is no
 * review data in the repository, `site.aggregateRating` is deliberately blank,
 * and schema.aggregateRating / schema.reviewSnippet() emit nothing while those
 * are empty. A testimonials page full of invented quotes would be the single
 * most damaging thing on the site, and it is also illegal under the Australian
 * Consumer Law.
 *
 * So this page does the honest version instead. It states plainly that the
 * reviews live on a third-party platform, links straight to them, and then
 * makes the case on things that are actually verifiable - the flat rate, the
 * guarantee, who does the work. The platform link is the real proof; anything
 * written here would only be a paraphrase of it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';
import { promises } from '../data/trust';
import * as schema from '../lib/schema';

const path = '/testimonials/';
const rate = site.pricing.flatRate;
const title = `Reviews & Testimonials | ${site.name}`;
const description =
  `Read customer reviews of Fix My Home Computer on Word of Mouth, or call ${site.phone.display} ` +
  `to book. Flat $${rate} rate, no call-out fee, no obligation.`;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path },
];

/**
 * What can be claimed without inventing anything: the commercial terms are
 * facts about the business, not testimonials, and they are the reason people
 * feel safe booking.
 */
const faqs = [
  {
    q: 'Where are your reviews?',
    a: `They are on Word of Mouth, where they were left by customers rather than collected by us - ${site.reviews.url}. Keeping them on an independent platform is the point: a review page on your own website can be edited, and anyone who has been online for a week knows what that is worth.`,
  },
  {
    q: 'Why are there no quotes on this page?',
    a: 'Because the only reviews worth reading are ones this business cannot touch. Copying them here would add nothing and would only create the impression they can be removed. The link above goes to the real thing.',
  },
  {
    q: 'How do I know you will actually turn up?',
    a: 'The reviews on the platform are the answer to that. Beyond them, the practical safeguards are the flat rate (so booking is low-risk), the no-pay-if-unfixable guarantee, and the fact that the quote comes with a firm time rather than an open-ended booking.',
  },
  {
    q: 'What if I am not happy with the work?',
    a: 'Tell me. If the fault is not fixed, I come back and fix it at no charge. If it is not something I can fix, that is settled before I start, and there is no charge for finding out.',
  },
];

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.faqPage(faqs),
    // No aggregateRating or review nodes: site.aggregateRating is blank and
    // inventing a rating is both a legal and a trust problem. See
    // src/lib/schema.ts.
    ...schema.reviewSnippet(),
  ],
});
---

<BaseLayout title={title} description={description} path={path} schema={jsonLd}>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow="Independent reviews · Not collected by us"
    title="Reviews"
    intro={[
      `The reviews of this business live on ${site.reviews.publisher}, not here. That is deliberate - reviews on an independent platform are the only ones worth reading, because this site cannot delete them.`,
      'Below that link is the honest version: what is actually guaranteed, in writing, by a business that only gets paid when the job gets done.',
    ]}
    icon="star"
  />

  <div class="container-page space-y-14 py-14 sm:space-y-16 sm:py-20">
    <section aria-labelledby="t-external" class="rounded-card border border-brand-500/25 bg-brand-500/10 p-6 sm:p-10">
      <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 id="t-external" class="text-h2">Read the real reviews</h2>
          <p class="mt-3 text-lead text-ink-600">
            Every review on {site.reviews.publisher} was written by a customer and cannot be edited
            or removed by us. It is the only place on this site where someone else is telling you
            what this business is like.
          </p>
        </div>
        <a
          href={site.reviews.url}
          target="_blank"
          rel="noopener"
          class="flex shrink-0 items-center gap-2 rounded-xl bg-brand-700 px-6 py-3.5 text-base font-bold text-white transition hover:bg-brand-800"
        >
          {site.reviews.label}
          <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M12 3h5v5h-1.5V6.1l-6.4 6.4-1.1-1.1 6.4-6.4H12V3ZM4 5h5v1.5H5.5v9h9V11H16v5H4V5Z"></path>
          </svg>
        </a>
      </div>
    </section>

    <section aria-labelledby="t-guaranteed">
      <h2 id="t-guaranteed" class="text-h2">What is actually guaranteed</h2>
      <p class="mt-3 max-w-2xl text-lead text-ink-600">
        Reviews tell you how it felt. These are the terms - the things that are true whether or not
        anyone bothers to write about them.
      </p>
      <div class="mt-8 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          promises.map((p) => (
            <div class="rounded-card border border-ink-200 bg-white/[0.06] p-6">
              <h3 class="text-[1.05rem] font-bold text-ink-900">{p.h}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">{p.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <FaqList faqs={faqs} title="About reviews and guarantees" />

    <CallToAction
      title="Book a repair, or ask a question first"
      body={`Flat $${rate} for the first hour and no call-out fee, so a booking is low-risk. Call ${site.phone.display} and describe the fault - you will get a straight answer on cost and timing.`}
    />
  </div>
</BaseLayout>
