---
/**
 * Primary conversion block. Sits at the end of the main content on every
 * page, so the phone number and quote form are reachable without scrolling
 * back up.
 */
import { site } from '../data/site';

interface Props {
  /** Overrides the heading - suburb pages pass their own. */
  title?: string;
  body?: string;
  /** Compact variant drops the stats row. */
  compact?: boolean;
}

const {
  title = 'Computer trouble? Call Robert.',
  body = 'Describe the problem on the phone. You will get an honest answer about whether it is worth fixing, and what it will cost, before anyone is booked.',
  compact = false,
} = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden rounded-hero bg-hero-dark text-white',
    compact ? 'px-6 py-10 sm:px-10 sm:py-12' : 'px-6 py-14 sm:px-10 sm:py-16',
  ]}
  aria-labelledby="cta-heading"
>
  <div class="relative max-w-3xl">
    <h2 id="cta-heading" class="text-h2 text-white">
      {title}
    </h2>
    <p class="mt-4 text-lead text-brand-100">
      {body}
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href={site.phone.href}
        class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-white px-6 py-4 text-base font-bold text-brand-700 shadow-lift transition hover:bg-brand-50"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.1a.75.75 0 0 1 .74.64l.5 2.5a.75.75 0 0 1-.19.7L5.4 7.3a12 12 0 0 0 7.3 7.3l1.46-1.25a.75.75 0 0 1 .7-.19l2.5.5a.75.75 0 0 1 .64.74v2.1a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 2 5v-1.5Z"></path>
        </svg>
        Call {site.phone.display}
      </a>
<a
    href={site.quoteForm.url}
    data-quote-open
    class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/40 px-6 py-4 text-base font-semibold text-white transition hover:border-white hover:bg-white/10"
  >
        Get a free quote online
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z"></path>
        </svg>
      </a>
    </div>

    {
      !compact && (
        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/15 pt-8 sm:grid-cols-4">
          {[
            { dt: 'Onsite rate', dd: `$${site.pricing.flatRate}`, sub: 'first hour' },
            { dt: 'Call-out fee', dd: '$0', sub: 'never' },
            { dt: 'Weekend surcharge', dd: '$0', sub: 'incl. public holidays' },
            { dt: 'Typical visit', dd: '< 1 hr', sub: 'most problems' },
          ].map((f) => (
            <div>
              <dt class="text-xs font-medium tracking-wide text-brand-200 uppercase">{f.dt}</dt>
              <dd class="mt-1 text-2xl font-extrabold text-white">{f.dd}</dd>
              <dd class="text-xs text-brand-200">{f.sub}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
