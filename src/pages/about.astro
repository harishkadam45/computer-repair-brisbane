---
/**
 * About page.
 *
 * The job here is to be the answer to "who is going to turn up at my house".
 * A trade business sells the same technical work as everyone else, so the
 * differentiator is trust in the individual, and the only way to build that is
 * to be specific and to admit the limits.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';
import { suburbs } from '../lib/suburbs';
import * as schema from '../lib/schema';

const path = '/about/';
const title = `About ${site.technician.name} | ${site.name} Brisbane`;
const description =
  `${site.technician.name} is a ${site.technician.credential} computer repair technician ` +
  `covering ${site.serviceAreas.join(', ')} and ${suburbs.length} suburbs. One technician, one ` +
  `flat $${site.pricing.flatRate} rate, no call-out fee. Call ${site.phone.display}.`;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

/** What the ex-IBM help desk years actually consisted of, in plain terms. */
const BACKGROUND = [
  {
    title: 'Years spent on a help desk',
    body: `Before this was a one-person business it was a support queue. ${site.technician.name} spent years on the help desk of the largest IT company in the world, taking calls from people whose computer had just stopped doing the one thing they needed it to do. The job was never really about components. It was about working out which of a hundred possible causes fits the symptom, from a phone call, without the person on the other end understanding anything technical.`,
  },
  {
    title: 'Why that matters at your kitchen table',
    body: 'A help desk learns to diagnose fast because the queue does not wait. It also learns which fixes are worth doing and which are a waste of the customer\'s money - because you find out what happens next. On a job where there is no follow-up queue, that judgement is the entire service, and it is the part that cannot be automated away.',
  },
  {
    title: 'One person, not a company',
    body: 'This is deliberately a one-person business. The technician who answers the phone is the technician who arrives and does the work. There is no dispatcher, no subcontractor, no junior tech learning on your machine, and nobody whose commission depends on selling you a service plan. It also means the rates are competitive, because there is no office, no insurance overhead and no dispatch system baked into your invoice.',
  },
  {
    title: 'Straight answers, including the bad ones',
    body: 'If your computer can be fixed for a hundred and fifty dollars, you will hear that. If it cannot be fixed, you will hear that too, and you will not be charged for the diagnosis. If a part is not worth fitting in a machine of that age, that is what you will be told. The business runs on people calling back, which is not something that survives telling people what they do not want to hear.',
  },
];

const VALUES = [
  {
    title: 'The price is the price',
    body: `$${site.pricing.flatRate} for the first hour, whatever the job. Not a cheaper rate for a quick look and a bigger one once I know what I am looking at. No call-out fee, no weekend surcharge, and travel included.`,
  },
  {
    title: 'Tell me before you spend',
    body: 'If a job is going to take another hour, or needs a part, you hear it while it is still a decision rather than an invoice.',
  },
  {
    title: 'Explain it properly',
    body: 'You get told what was actually wrong in language that does not require a glossary. If it is worth knowing for next time, you get told that too.',
  },
  {
    title: 'Clean up after yourself',
    body: 'Old data wiped, backups verified, the machine handed back tidy. No mystery files, no toolbars you did not ask for, no "please rate us" popup.',
  },
];

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [schema.breadcrumbList(trail), schema.person(site.technician.name, site.technician.background)],
});
---

<BaseLayout title={title} description={description} path={path} schema={jsonLd}>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <section class="border-b border-ink-100 hero-wash">
    <div class="container-page py-14 sm:py-20">
      <div class="max-w-3xl">
        <p
          class="inline-flex items-center gap-2 rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold tracking-wide text-brand-300 uppercase ring-1 ring-brand-200"
        >
          About the business
        </p>
        <h1 class="mt-5 text-h1">
          {site.technician.name}. One technician, {suburbs.length} suburbs.
        </h1>
        <p class="mt-6 text-lead text-ink-700">
          {site.technician.name} is a {site.technician.credential} computer repair technician
          working across {site.serviceAreas.join(', ')} and the surrounding suburbs. This page
          explains how the business works, and - just as importantly - what it will not do.
        </p>
      </div>
    </div>
  </section>

  <div class="container-page space-y-14 pt-14 pb-14 sm:space-y-16 sm:pt-20 sm:pb-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="space-y-10 lg:col-span-7 min-w-0">
        {
          BACKGROUND.map((b) => (
            <section>
              <h2 class="text-h3">{b.title}</h2>
              <p class="mt-3 text-lead text-ink-700">{b.body}</p>
            </section>
          ))
        }
      </div>

      <aside class="lg:col-span-5 min-w-0">
        <div class="sticky top-24 space-y-4">
          <div class="rounded-card border border-ink-200 bg-white/[0.06] p-6">
            <h2 class="text-sm font-bold tracking-wide text-ink-500 uppercase">The short version</h2>
            <dl class="mt-4 space-y-3.5 text-sm">
              {
                [
                  ['Who does the work', site.technician.name],
                  ['Qualification', site.technician.credential],
                  ['First hour', `$${site.pricing.flatRate} flat`],
                  ['Call-out fee', '$0'],
                  ['Weekends & public holidays', 'No surcharge'],
                  ['Suburbs covered', String(suburbs.length)],
                  ['Bookings', '7 days a week'],
                ].map(([dt, dd]) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-ink-50 pb-3 last:border-0 last:pb-0">
                    <dt class="text-ink-500">{dt}</dt>
                    <dd class="text-right font-bold text-ink-900">{dd}</dd>
                  </div>
                ))
              }
            </dl>
            <a
              href={site.phone.href}
              class="mt-6 block rounded-xl bg-brand-500 px-5 py-3.5 text-center text-base font-bold text-brand-950 shadow-cta transition hover:bg-brand-400"
            >
              Call {site.phone.display}
            </a>
          </div>

          <div class="rounded-card border border-ink-200 bg-ink-50 p-6">
            <h2 class="text-sm font-bold tracking-wide text-ink-500 uppercase">What is not offered</h2>
            <ul class="mt-4 space-y-2.5 text-sm text-ink-700">
              {
                [
                  'No service plans or ongoing contracts',
                  'No call centre - you speak to the technician',
                  'No parts markup and no “handling fee”',
                  'No upselling work you do not need',
                  'No charge for a diagnosis that finds nothing fixable',
                ].map((item) => (
                  <li class="flex gap-2.5">
                    <svg class="mt-0.5 size-4 shrink-0 text-ink-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M4 10.5 8 14.5 16 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>

    <section aria-labelledby="values-heading" class="border-t border-ink-100 pt-14">
      <h2 id="values-heading" class="text-h2">How the work is done</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          VALUES.map((v) => (
            <div class="rounded-card border border-ink-200 bg-white/[0.06] p-6">
              <h3 class="text-[1.05rem] font-bold text-ink-900">{v.title}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">{v.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <div class="container-page pb-16 sm:pb-20">
    <CallToAction
      title="Talk to the technician, not a call centre"
      body="Describe the problem and you will get a straight answer about whether it is fixable and what it will cost, before anything is booked."
    />
  </div>
</BaseLayout>
