---
/**
 * Service card. Used on the services index, the home page, and the
 * related-services block at the foot of every service page.
 */
import type { IconName } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  icon: IconName;
  /** Rendered as a price pill when present. */
  price?: number;
  priceLabel?: string;
  /** Adds the "starting at" prefix. */
  pricePrefix?: string;
}

const { href, title, summary, icon, price, priceLabel, pricePrefix } = Astro.props;
---

<a
    href={href}
    data-reveal
    class="group flex flex-col rounded-card border border-ink-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lift"
  >
  <span class="flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
    <Icon name={icon} class="size-6" />
  </span>
  <h3 class="mt-4 text-[1.05rem] font-bold text-ink-900 transition group-hover:text-brand-700">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{summary}</p>
  {
    (price !== undefined || priceLabel) && (
      <p class="mt-4 inline-flex w-fit items-baseline gap-1.5 rounded-full bg-ink-50 px-2.5 py-1 text-xs font-semibold text-ink-700">
        {pricePrefix && <span class="font-normal text-ink-500">{pricePrefix}</span>}
        {price !== undefined && <span class="text-brand-700">${price}</span>}
        {priceLabel && <span class="font-normal text-ink-500">{priceLabel}</span>}
      </p>
    )
  }
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
    Learn more
    <svg class="size-4 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z"></path>
    </svg>
  </span>
</a>
