---
/**
 * The four-step "how a visit works" trust block. This is the conversion
 * argument for a business that is one person: the person who answers is the
 * person who fixes it.
 */
const steps = [
  {
    n: '1',
    t: 'You call and describe it',
    d: 'No booking form and no call centre. I will tell you honestly whether it sounds like something I can fix, and roughly what it will cost.',
  },
  {
    n: '2',
    t: 'I come to you',
    d: 'Early morning, evening, weekend or public holiday - all normal, none surcharged. Home or office. You can watch the work.',
  },
  {
    n: '3',
    t: 'You are told before anything happens',
    d: 'The price is agreed before the job starts, and if a part is needed you get the cost price rather than a mark-up.',
  },
  {
    n: '4',
    t: 'It works, or you do not pay',
    d: 'If I cannot fix it, there is no charge. If something I did stops working, I come back and look at it.',
  },
];
---

<section class="rounded-hero bg-ink-50 p-6 sm:p-8 lg:p-10" aria-labelledby="how-heading">
  <h2 id="how-heading" class="text-h2">
    How a visit works
  </h2>
<ol class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li data-reveal>
            <span class="flex size-8 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">
            {s.n}
          </span>
          <h3 class="mt-3.5 text-[1.02rem] font-bold text-ink-900">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{s.d}</p>
        </li>
      ))
    }
  </ol>
</section>
