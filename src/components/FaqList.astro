---
/**
 * FAQ block. Mirrors the FAQPage schema exactly - same questions, same
 * answers, same order - so the structured data matches what is on screen.
 */
import type { Faq } from '../data/services';

interface Props {
  faqs: Faq[];
  title?: string;
  intro?: string;
}

const { faqs, title = 'Frequently asked questions', intro } = Astro.props;
---

{
  faqs.length > 0 && (
    <section aria-labelledby="faq-heading" class="not-prose">
      <h2 id="faq-heading" class="text-h2">
        {title}
      </h2>
      {intro && <p class="mt-3 max-w-2xl text-lead text-ink-600">{intro}</p>}

      <div class="mt-8 divide-y divide-ink-200 overflow-hidden rounded-card border border-ink-200 bg-white/[0.06]">
{faqs.map((faq, i) => (
            <details data-reveal class="group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 transition hover:bg-ink-50 sm:px-6">
              <h3 class="text-[1.02rem] font-semibold text-ink-900">{faq.q}</h3>
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-300 transition group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 0 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 sm:px-6">
              <p class="max-w-3xl text-[0.97rem] leading-relaxed text-ink-600">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
