---
/**
 * Site header.
 *
 * The nav is rendered server-side as real links - no JavaScript needed for
 * anything a crawler or a crawler-less reader has to see. The only script on
 * the page is a small disclosure toggle for the mobile menu, and it is inlined
 * and deferred.
 */
import { site } from '../data/site';
import { families, serviceBySlug, serviceGroups } from '../data/services';
import SearchField from './SearchField.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;

/*
 * Shared styling for the two utility-bar actions.
 *
 * Both are the same orange pill at the same size, so the class list lives in
 * one constant. Duplicated as two literals they had already drifted - the pill
 * carried 600 weight and 12px of vertical padding while the link beside it was
 * 400 weight with none, which made the phone read as a large button and the
 * quote link as small print. One source means they cannot drift apart again.
 *
 * 0.8125rem (13px) rather than text-sm: at 14px the phone pill pushed the bar
 * past the available width at 1024. leading-5 fixes the line box so the two
 * pills stay the same height whatever the label.
 */
const utilityPill =
  'flex items-center gap-1.5 rounded-xl bg-brand-500 px-3.5 py-1 text-[0.8125rem] leading-5 font-semibold whitespace-nowrap text-white shadow-cta transition hover:bg-brand-600';

/** Grouped for the dropdown, minus any slug that no longer resolves. */
const megaGroups = serviceGroups
  .map((g) => ({
    heading: g.heading,
    items: g.slugs.map((slug) => serviceBySlug.get(slug)).filter((s) => s !== undefined),
  }))
  .filter((g) => g.items.length > 0);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="bg-dark-wash sticky top-0 z-50 border-b border-white/12">
  <!-- Utility bar: the two things people need on every page, above the fold.
       Transparent, so the header's wash runs through both rows. -->
  <div class="hidden border-b border-white/12 sm:block">
    <div class="container-page flex h-9 items-center justify-between text-sm">
      <p class="text-white/70">
        Flat <strong class="font-semibold text-white">${site.pricing.flatRate}</strong> rate ·
        no call-out fee · 7 days a week
      </p>
      <!-- Search. Real GET form to /search/, so it works with JS disabled.

           Two desktop placements exist and exactly one is visible at any width,
           because the main nav cannot hold a field at 1024px: usable space is
           logo (252) + nav (571) + gaps (32) against a 960px column, and the
           nav is already at min-content with "Services" wrapping. So the
           utility bar covers 1024-1119px and the nav takes over from 1120px,
           where the remaining slack grows past the field.

           The window is one arbitrary range query rather than lg plus
           min-[1120px]:hidden. Two show rules cannot express "and": each sets
           display:block on its own, so min+max left the field visible at
           1120px and up. A min-width hide also lost the cascade, because
           Tailwind emits the arbitrary variant ahead of `lg`, so the later
           `lg:block` rule won. A single range query has no such conflict. -->
      <SearchField
        id="nav-search"
        formClass="relative hidden w-64 shrink-0 [@media(min-width:1024px)_and_(max-width:1119px)]:block"
        inputClass="w-full rounded-lg border border-ink-200 bg-white/[0.06] py-1.5 pr-3 pl-8 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:outline-none"
      />

      <div class="flex items-center gap-4">
        <!-- The phone number, in the spot it has always held (immediately
             before "Get a quote"). Same colour and icon as the navbar button
             it replaces. -->
        <a href={site.phone.href} class={utilityPill}>
          <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.1a.75.75 0 0 1 .74.64l.5 2.5a.75.75 0 0 1-.19.7L5.4 7.3a12 12 0 0 0 7.3 7.3l1.46-1.25a.75.75 0 0 1 .7-.19l2.5.5a.75.75 0 0 1 .64.74v2.1a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 2 5v-1.5Z"
            ></path>
          </svg>
          <span class="sr-only">Call </span>{site.phone.display}
        </a>
        <!-- Same pill as the number beside it, with a matching icon so the two
             read as a pair. -->
        <a href={site.quoteForm.url} data-quote-open class={utilityPill}>
          <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              d="M17 2H3a1.5 1.5 0 0 0-1.5 1.5v11A1.5 1.5 0 0 0 3 16h2.5v3.2a.6.6 0 0 0 .93.5L10 16h7a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 17 2Zm-2.25 8.5h-9.5a.75.75 0 0 1 0-1.5h9.5a.75.75 0 0 1 0 1.5Zm0-3h-9.5a.75.75 0 0 1 0-1.5h9.5a.75.75 0 0 1 0 1.5Zm0-3h-6a.75.75 0 0 1 0-1.5h6a.75.75 0 0 1 0 1.5Z"
            ></path>
          </svg>
          Get a quote
        </a>
      </div>
    </div>
  </div>

  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="group flex shrink-0 items-center" aria-label={`${site.name} home`}>
      <img
        src="/images/Logo_big.png"
        alt=""
        width="378"
        height="220"
        class="h-10 w-auto rounded-lg"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Not shrink-0: this row is the one that can absorb a shortfall, which is
         why search lives in the utility bar above. At 1024px the nav is already
         at min-content and "Services" wraps, so nothing here can be pinned. -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <a
        href="/"
        class:list={[
          'rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
          path === '/' ? 'text-brand-400' : 'text-white/80 hover:bg-white/10 hover:text-white',
        ]}
        aria-current={path === '/' ? 'page' : undefined}
      >
        Home
      </a>

      <!-- Services has a dropdown of the service families. The panel sits below
           the whole header, so a small hover-intent delay in the script at the
           foot of this file bridges the gap to the pointer without a CSS
           hover bridge that would sit over the search field. -->
      <div class="group relative" data-mega>
        <a
          href="/services/"
          class:list={[
            'flex items-center gap-1.5 rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
            isActive('/services/') || isActive('/service-area/')
              ? 'text-brand-400'
              : 'text-white/80 hover:bg-white/10 hover:text-white',
          ]}
          aria-haspopup="true"
        >
          Services
          <svg
            class="size-3.5 text-white/60 transition group-hover:rotate-180"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"><path
              fill-rule="evenodd"
              d="M5.2 7.4a1 1 0 0 1 1.4 0L10 10.8l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.8a1 1 0 0 1 0-1.4Z"
              clip-rule="evenodd"></path></svg>
        </a>
        <div
          data-mega-panel
          class="bg-dark-wash invisible fixed top-[7.375rem] right-4 left-4 z-50 mx-auto w-auto max-w-[58rem] rounded-2xl border border-ink-100 p-5 opacity-0 shadow-lift transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <button
            type="button"
            data-mega-close
            class="absolute top-3 right-3 z-10 flex size-9 items-center justify-center rounded-lg text-ink-500 transition hover:bg-white/10 hover:text-white"
          >
            <span class="sr-only">Close menu</span>
            <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4Z"
              ></path>
            </svg>
          </button>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
            <div>
              <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                By device
              </p>
              <ul class="grid grid-cols-2 gap-1">
                {
                  families.map((f) => (
                    <li>
                      <a
                        href={`/${f.slug}/`}
                        class="block rounded-xl px-3 py-2.5 transition hover:bg-brand-500/10"
                      >
                        <span class="block text-sm font-semibold text-ink-900">{f.title}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-ink-500">
                          {f.summary.slice(0, 68)}…
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <p class="mt-5 border-t border-ink-100 px-1 pt-4 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                What we fix
              </p>
              <div class="grid gap-x-4 gap-y-4 sm:grid-cols-3">
                {
                  megaGroups.map((g) => (
                    <div>
                      <h3 class="px-3 pb-1 text-[0.8rem] font-bold text-ink-900">{g.heading}</h3>
                      <ul>
                        {g.items.map((s) => (
                          <li>
                            <a
                              href={`/${s.slug}/`}
                              class="block rounded-lg px-3 py-1.5 text-sm text-ink-700 transition hover:bg-brand-500/10 hover:text-brand-300"
                            >
                              {s.shortTitle}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="border-t border-ink-100 pt-4 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-6">
              <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                Start here
              </p>
              <ul class="space-y-1">
                {
                  [
                    { label: `Call ${site.phone.display}`, href: site.phone.href, note: 'Fastest way to get it fixed.' },
                    { label: 'Request a quote', href: site.quoteForm.url, note: 'If you would rather not phone.', modal: true },
                    { label: 'See pricing', href: '/pricing/', note: `Flat $${site.pricing.flatRate}, no call-out fee.` },
                  ].map((t) => (
                    <li>
<a
                          href={t.href}
                          data-quote-open={t.modal ? '' : undefined}
                          rel={t.href.startsWith('http') ? 'noopener' : undefined}
                          target={t.href.startsWith('http') ? '_blank' : undefined}
                          class="block rounded-xl px-3 py-2.5 transition hover:bg-brand-500/10"
                      >
                        <span class="block text-sm font-semibold text-brand-300">{t.label}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-ink-500">{t.note}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a
                href="/services/"
                class="mt-3 block rounded-xl bg-ink-950 px-3 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-white/10"
              >
                All services →
              </a>
            </div>
          </div>
        </div>
      </div>

      {
        nav
          .filter((item) => !['/', '/services/'].includes(item.href))
          .map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
              isActive(item.href)
                ? 'text-brand-400'
                : 'text-white/80 hover:bg-white/10 hover:text-white',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <!-- Search, last in the nav after Contact. The width is capped by the
           nav's real slack: 217px at 1120 and 249px from 1280, so w-48 then
           w-56 - a wider field pushes "Services" onto a second line. The
           utility bar owns 1024-1119px, where this one is hidden. -->
      <SearchField
        id="navbar-search"
        formClass="relative hidden w-48 shrink-0 min-[1120px]:block xl:w-56"
        inputClass="w-full rounded-lg border border-ink-200 bg-ink-50 py-2 pr-3 pl-8 text-[0.95rem] text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:bg-white/[0.06] focus:outline-none"
      />
    </nav>

    <!-- The phone number is no longer duplicated here; it lives in the utility
         bar above, immediately before "Get a quote". -->
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="flex size-11 items-center justify-center rounded-xl border border-white/25 text-white transition hover:bg-white/10 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile search. Same form/action as desktop so it degrades identically. -->
  <div class="border-b border-ink-100 bg-white/[0.06] lg:hidden">
    <SearchField
      id="mobile-search"
      formClass="container-page py-3"
      inputClass="w-full rounded-xl border border-ink-200 bg-ink-50 py-2.5 pr-3 pl-8 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:bg-white/[0.06] focus:outline-none"
      resultsClass="mt-2 max-h-[min(22rem,50vh)] overflow-y-auto overscroll-contain rounded-xl border border-ink-100 bg-white/[0.06] shadow-lift"
      label="Search services"
    />
  </div>

  <!-- Mobile nav. Hidden with [hidden] so it is genuinely absent from the a11y tree. -->
  <div id="mobile-nav" class="hidden border-t border-ink-100 bg-white/[0.06] lg:hidden" data-menu>
    <nav class="container-page py-4" aria-label="Mobile">
      <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
        By device
      </p>
      <ul class="grid grid-cols-2 gap-1.5">
        {
          families.map((f) => (
            <li>
              <a
                href={`/${f.slug}/`}
                class="block rounded-lg bg-brand-500/10 px-3 py-2.5 text-sm font-semibold text-brand-300"
              >
                {f.title}
              </a>
            </li>
          ))
        }
      </ul>
      {
        megaGroups.map((g) => (
          <div class="mt-4">
            <h3 class="px-1 pb-1 text-[0.8rem] font-bold text-ink-900">{g.heading}</h3>
            <ul class="grid grid-cols-2 gap-x-2 gap-y-0.5">
              {g.items.map((s) => (
                <li>
                  <a
                    href={`/${s.slug}/`}
                    class="flex min-h-11 items-center rounded-lg px-3 py-2.5 text-sm text-ink-700 transition hover:bg-brand-500/10 hover:text-brand-300"
                  >
                    {s.shortTitle}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <a
        href="/services/"
        class="mt-2 block rounded-lg bg-ink-950 px-3 py-2.5 text-center text-sm font-semibold text-white"
      >
        All services
      </a>
      <ul class="mt-4 space-y-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg px-3 py-2.5 text-[0.95rem] font-semibold',
                  isActive(item.href) ? 'bg-ink-50 text-brand-300' : 'text-ink-800',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
<a
          href={site.quoteForm.url}
          data-quote-open
          class="mt-4 block rounded-xl bg-brand-500 px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Get a free quote
        </a>
      <a
        href={site.phone.href}
        class="mt-2 block rounded-xl border-2 border-brand-500 px-4 py-3 text-center text-sm font-bold text-brand-300"
      >
        Call {site.phone.display}
      </a>
    </nav>
  </div>
</header>

<!-- Lives in public/scripts/ because it is a plain IIFE with no imports, so
     it needs no bundling - and every page shares one copy. -->
<script src="/scripts/search.js" defer></script>

<script is:inline>
  // Progressive enhancement only: the nav is a plain <nav> with real links
  // before this runs. No framework, no hydration.
  (function () {
    // Hover intent for the Services mega menu. The panel hangs below the whole
    // header, so the pointer crosses a gap that a plain :hover on the group
    // cannot span. A short close delay keeps it open while a hand travels
    // across - without a CSS bridge element, which would have to cover the
    // search field and the nav row to catch the diagonal path.
    document.querySelectorAll('[data-mega]').forEach(function (group) {
      var panel = group.querySelector('[data-mega-panel]');
      var trigger = group.querySelector('a');
      if (!panel) return;
      var timer = null;
      var dismissed = false;

      function show() {
        clearTimeout(timer);
        panel.style.visibility = 'visible';
        panel.style.opacity = '1';
      }
      function hide() {
        panel.style.visibility = 'hidden';
        panel.style.opacity = '0';
      }
      // Hand the panel back to the CSS (:hover/:focus-within) state.
      function reset() {
        dismissed = false;
        panel.style.visibility = '';
        panel.style.opacity = '';
      }

      group.addEventListener('mouseenter', function () {
        if (!dismissed) show();
      });
      group.addEventListener('mouseleave', function () {
        dismissed = false;
        timer = setTimeout(hide, 700);
      });
      // Keyboard: clear the inline overrides when focus leaves the group so
      // :focus-within can open it again next time.
      group.addEventListener('focusout', function (e) {
        if (group.contains(e.relatedTarget)) clearTimeout(timer);
        else reset();
      });

      var closer = panel.querySelector('[data-mega-close]');
      if (closer) {
        closer.addEventListener('click', function () {
          dismissed = true;
          clearTimeout(timer);
          hide();
          if (trigger) trigger.focus();
        });
      }
    });

    var toggle = document.querySelector('[data-menu-toggle]');
    var menu = document.querySelector('[data-menu]');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
    });
  })();
</script>
