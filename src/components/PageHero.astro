---
/**
 * Hero block shared by every service and suburb page. Pairs the pitch with the
 * price card, because on this site the price is the reason most people are
 * still reading.
 */
import type { IconName } from '../data/services';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  /** Paragraphs of pre-formatted HTML. */
  intro: string[];
  icon: IconName;
  /** Extra facts appended to the price card, e.g. postcode / turnaround. */
  facts?: Fact[];
  badges?: string[];
}

const { eyebrow, title, intro, icon, facts, badges } = Astro.props;
---

<section class="border-b border-ink-100 bg-brand-mesh">
  <div class="container-page py-12 sm:py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7 min-w-0">
        {
          eyebrow && (
<p data-enter="fade" class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-bold tracking-wide text-brand-700 uppercase ring-1 ring-brand-200">
                <span class="size-1.5 rounded-full bg-brand-500" />
                {eyebrow}
              </p>
            )
          }
          <h1 data-enter style="--reveal-i: 1" class="mt-4 text-h1">
            {title}
          </h1>
          <div data-enter style="--reveal-i: 2" class="mt-5 max-w-2xl space-y-4 text-lead text-ink-700">
            {intro.map((p) => <p set:html={p} />)}
          </div>

          <div data-enter="pop" style="--reveal-i: 3" class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phone.href}
            class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-brand-500 px-6 py-3.5 text-base font-bold text-white shadow-cta transition hover:bg-brand-600"
          >
            <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.1a.75.75 0 0 1 .74.64l.5 2.5a.75.75 0 0 1-.19.7L5.4 7.3a12 12 0 0 0 7.3 7.3l1.46-1.25a.75.75 0 0 1 .7-.19l2.5.5a.75.75 0 0 1 .64.74v2.1a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 2 5v-1.5Z"
              ></path>
            </svg>
            Call {site.phone.display}
          </a>
<a
    href={site.quoteForm.url}
    data-quote-open
    class="inline-flex items-center justify-center rounded-xl border-2 border-brand-500 px-6 py-3.5 text-base font-bold text-brand-700 transition hover:bg-brand-50"
  >
            Get a free quote
          </a>
        </div>

        {
          badges && badges.length > 0 && (
            <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2">
              {badges.map((b) => (
                <li class="flex items-center gap-1.5 text-sm font-medium text-ink-700">
                  <svg
                    class="size-4 shrink-0 text-success-600"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" />
                  </svg>
                  {b}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="lg:col-span-5 min-w-0">
        <div class="rounded-card border border-ink-200 bg-white p-6 shadow-card sm:p-7">
          <div class="flex items-center gap-3">
            <span class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={icon} class="size-7" />
            </span>
            <div>
              <p class="text-sm font-medium text-ink-500">Onsite rate</p>
              <p class="text-3xl font-extrabold text-ink-900">
                ${site.pricing.flatRate}<span class="ml-1.5 text-sm font-medium text-ink-500">/ first hour</span>
              </p>
            </div>
          </div>

          <dl class="mt-6 space-y-3 border-t border-ink-100 pt-5 text-sm">
            {
              [
                ['Call-out fee', '$0 - never'],
                ['Weekend & public holidays', 'No surcharge'],
                ['After the first hour', 'Billed in 15-minute blocks'],
                ['Replacement parts', 'At cost, no mark-up'],
              ].map(([dt, dd]) => (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-ink-600">{dt}</dt>
                  <dd class="text-right font-semibold text-ink-900">{dd}</dd>
                </div>
              ))
            }
          </dl>

          {
            facts && facts.length > 0 && (
              <dl class="mt-5 space-y-3 border-t border-ink-100 pt-5 text-sm">
                {facts.map((f) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-ink-600">{f.label}</dt>
                    <dd class="text-right font-semibold text-ink-900">{f.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          <p class="mt-5 border-t border-ink-100 pt-5 text-xs leading-relaxed text-ink-500">
            {site.pricing.gstNote} If it cannot be fixed, you do not pay.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
