---
/**
 * Template for a standalone service page.
 *
 * Everything the page needs is passed in; this file owns the document
 * structure so that adding a service means adding a data entry, not writing
 * another 150 lines of Astro.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CopySection from '../components/CopySection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import RelatedServices from '../components/RelatedServices.astro';
import CallToAction from '../components/CallToAction.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { services, families } from '../data/services';
import { formatInline } from '../lib/seo';
import * as schema from '../lib/schema';

interface Props {
  slug: string;
  /** Optional override; falls back to the service's own data. */
  title?: string;
  description?: string;
  /** Overrides the FAQ section heading. */
  faqTitle?: string;
}

const { slug, faqTitle } = Astro.props;
const service = services.find((s) => s.slug === slug);

if (!service) {
  throw new Error(`Unknown service slug: "${slug}". Add it to src/data/services.ts.`);
}

const path = `/${service.slug}/`;
const title = service.metaTitle;
const description = service.metaDescription;
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.title, path },
];

const ctaTitle = `Need a ${service.shortTitle.toLowerCase()} job done?`;
const ctaBody = `${site.technician.name} is a ${site.technician.credential} ex-IBM help desk technician. One flat rate of $${site.pricing.flatRate} for the first hour, no call-out fee, and no surcharge on weekends or public holidays.`;

const jsonLd = schema.graph({
  path,
  name: service.metaTitle,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.service({
      name: service.title,
      description: service.summary,
      path,
      price: service.price,
    }),
    schema.faqPage(service.faqs),
  ],
});

/** Sibling services on the same index, for the "others people searched" block. */
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<!--
  brandInTitle is off: these metaTitles are already service + location +
  differentiator ("Data Recovery Brisbane | Recover Files From Failed Drives"),
  which is 55 characters before the 22-character brand suffix is added. Every
  one of these pages was over the 62-character budget purely because of the
  suffix, and Google re-appends the site name on its own in most result
  layouts, so those pixels buy very little.
-->
<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={jsonLd}
  brandInTitle={false}
>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow="Fixed onsite · No call-out fee"
    title={service.title}
    intro={service.intro.map((p) => formatInline(p))}
    icon={service.icon}
    badges={[
      `Flat $${site.pricing.flatRate} rate`,
      'No call-out fee',
      'Weekends & public holidays',
      'Fixed or you do not pay',
    ]}
    facts={[
      { label: 'Typical turnaround', value: service.turnaround },
      ...(service.price ? [{ label: 'This service', value: `$${service.price} flat` }] : []),
    ]}
  />

  <div class="container-page space-y-14 py-14 sm:space-y-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="space-y-12 lg:col-span-8 min-w-0">
        {service.sections.map((section, i) => <CopySection section={section} id={`s-${i}`} />)}
      </div>

      <!-- Sidebar: the other service families, so every page is a hub. -->
      <aside class="lg:col-span-4 min-w-0">
        <div class="lg:sticky lg:top-28">
          <h2 class="text-sm font-bold tracking-wide text-ink-900 uppercase">
            We also repair
          </h2>
          <ul class="mt-4 space-y-2">
            {
              families
                .filter((f) => f.slug !== service.slug)
                .map((f) => (
                  <li>
                    <a
                      href={`/${f.slug}/`}
                      class="flex items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-4 py-3.5 transition hover:border-brand-300 hover:bg-brand-50"
                    >
                      <span class="text-sm font-semibold text-ink-900">{f.title}</span>
                      <svg
                        class="size-4 shrink-0 text-ink-400"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M7.2 4.6a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4L11.5 10 7.2 5.6a1 1 0 0 1 0-1.4Z" />
                      </svg>
                    </a>
                  </li>
                ))
            }
          </ul>

          <div class="mt-6 rounded-card border border-brand-200 bg-brand-50 p-5">
            <h2 class="text-sm font-bold text-brand-900">Every suburb, same price</h2>
            <p class="mt-2 text-sm leading-relaxed text-brand-800">
              The flat rate does not change with distance, suburb or day of the week. See how we
              cover your area.
            </p>
            <a
              href="/service-area/"
              class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 hover:text-brand-800"
            >
              Check your suburb
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z" />
              </svg>
            </a>
          </div>

          <div class="mt-6 rounded-card border border-ink-200 bg-white p-5">
            <h2 class="text-sm font-bold text-ink-900">Independent pricing</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">
              {site.reviews.label}.
            </p>
            <a
              href={site.reviews.url}
              rel="noopener nofollow"
              target="_blank"
              class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 hover:text-brand-800"
            >
              Read the reviews
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z" />
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <HowItWorks />
    <FaqList faqs={service.faqs} title={faqTitle ?? `${service.shortTitle} - common questions`} />
    <RelatedServices
      slugs={service.related}
      title="You might also need"
      intro="Most jobs are a combination of these. If you are not sure which one you need, describe the problem on the phone and I will tell you."
    />

    <section aria-labelledby="others-heading">
      <h2 id="others-heading" class="text-h2">Other services</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((s) => (
            <ServiceCard
              href={`/${s.slug}/`}
              title={s.title}
              summary={s.summary}
              icon={s.icon}
              price={s.price}
              pricePrefix={s.price ? 'from' : undefined}
            />
          ))
        }
      </div>
    </section>

    <CallToAction title={ctaTitle} body={ctaBody} />
  </div>
</BaseLayout>
