---
/**
 * Blog index at /blog/.
 *
 * 110 migrated posts, ~98,000 words, published between 2017 and now. The index
 * is the hub that keeps them from becoming orphans: every post links here, and
 * every post is reachable from the header.
 *
 * Only the six most recent posts are offered up front. A 110-card wall is a
 * wall nobody scrolls, and the six newest are the only ones a returning reader
 * plausibly came for. The remaining 104 are grouped by year behind one button,
 * and the choice is remembered, so somebody who wanted the archive stops being
 * asked for it.
 *
 * The archive is rendered into the page but starts hidden, which keeps the
 * first paint cheap - the images inside it are lazy and are never fetched while
 * it is hidden - and makes revealing it instant and offline-proof.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CallToAction from '../../components/CallToAction.astro';
import BlogCard from '../../components/BlogCard.astro';
import { site } from '../../data/site';
import { posts } from '../../data/posts';
import { clampDescription } from '../../lib/seo';
import * as schema from '../../lib/schema';

const path = '/blog/';
const title = `Computer Repair Blog | ${posts.length} Articles | ${site.name}`;
const description = clampDescription(
  `Practical computer repair advice from ${site.technician.name} in Brisbane: what's actually ` +
    `wrong with your machine, what it costs to fix, and when replacing it makes more sense. ` +
    `${posts.length} articles.`,
);

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];

/** How many posts are offered before the button. */
const INITIAL = 6;

const latest = posts.slice(0, INITIAL);
const rest = posts.slice(INITIAL);

/** Newest first, grouped into years for scannability. */
const byYear = new Map<string, typeof posts>();
for (const post of rest) {
  const year = post.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));

const totalWords = Math.round(posts.reduce((n, p) => n + p.words, 0) / 1000);

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.itemList({
      name: 'Computer repair articles',
      path,
      items: posts.map((p) => ({ name: p.title, path: p.path })),
    }),
  ],
});
---

<BaseLayout title={title} description={description} path={path} schema={jsonLd}>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow={`${posts.length} articles · ${totalWords}k words`}
    title="Computer repair advice"
    intro={[
      `What people ask me most, written up properly. What is actually wrong with the machine, what it ` +
        `costs to fix, and the cases where replacing it is the sensible call.`,
      `Everything here is written from the bench rather than assembled from a list of search terms - ` +
        `if a fix is not worth doing I say so.`,
    ]}
    icon="support"
  />

  <div class="container-page space-y-12 py-14 sm:space-y-16 sm:py-20">
    <section aria-labelledby="b-latest">
      <h2 id="b-latest" class="text-h2">Newest</h2>
      <p class="mt-3 text-sm text-ink-500" data-blog-count>
        Showing the {latest.length} newest of {posts.length} articles.
      </p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p) => <BlogCard post={p} />)}
      </div>
    </section>

    <div id="blog-archive" data-total={posts.length} data-shown={latest.length}></div>

    <!--
      The archive markup lives in a <template> rather than in the page behind a
      hidden attribute. display:none does NOT stop Firefox or Safari fetching
      lazy images inside it: measured on this page, a hidden archive pulled
      106 images and about 5 MB on a first visit that showed six cards. Template
      content is inert in every engine, so nothing is requested until it is
      cloned in. The markup is still in the HTML, so opening it stays instant.
    -->
    <template id="blog-archive-src">
      <section aria-labelledby="b-archive">
        <h2 id="b-archive" class="text-h2">Everything else</h2>
        <div class="mt-8 space-y-10">
          {
            years.map(([year, list]) => (
              <div>
                <h3 class="flex items-baseline gap-3 text-sm font-bold tracking-wide text-ink-900 uppercase">
                  {year}
                  <span class="text-xs font-semibold tracking-normal text-ink-500 normal-case">
                    {list.length} article{list.length === 1 ? '' : 's'}
                  </span>
                </h3>
                <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {list.map((p) => (
                    <BlogCard post={p} reveal={false} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </template>

    <noscript>
      <p class="text-center text-[0.95rem] text-ink-600">
        The rest of the archive needs JavaScript to expand.
        <a href="/blog/archive/" class="font-semibold text-brand-300 underline">See all {posts.length} articles by year</a>.
      </p>
    </noscript>

    <div class="flex justify-center">
      <button
        type="button"
        id="blog-more"
        data-blog-more
        aria-expanded="false"
        aria-controls="blog-archive"
        class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/[0.06] px-7 py-3.5 text-[0.95rem] font-bold text-ink-900 transition hover:border-brand-300 hover:bg-brand-500/10 hover:text-brand-300"
      >
        <span data-blog-more-label>Show the other {rest.length} articles</span>
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 3a1 1 0 0 1 1 1v9.2l3.6-3.6a1 1 0 1 1 1.4 1.4l-5.3 5.3a1 1 0 0 1-1.4 0l-5.3-5.3a1 1 0 1 1 1.4-1.4L9 13.2V4a1 1 0 0 1 1-1Z"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="container-page pb-14 sm:pb-20">
    <CallToAction
      title="Rather just have it fixed?"
      body={`Flat $${site.pricing.flatRate} for the first hour, no call-out fee, and no surcharge at the weekend. Call ${site.phone.display} and describe the fault - you will get a straight answer on cost.`}
    />
  </div>

<script>
    /**
     * Six posts, then one button for the other 104. Once somebody has asked for
     * the archive they get it without asking again - a flag in localStorage,
     * which is the only state worth keeping, since the alternative is a wall of
     * cards on every future visit.
     *
     * The archive arrives by cloning a <template>. Keeping it in the page but
     * merely hidden does not work: display:none does not stop Firefox or Safari
     * fetching lazy images underneath it, and that cost about 5 MB on a first
     * visit showing six cards. Template content is inert until it is cloned.
     *
     * Runs inline and unguarded: if storage is unavailable (private mode, a
     * blocked origin) the button still opens the archive, it just stops being
     * remembered.
     */
    (function () {
      var KEY = 'blog:archive-open';
      /*
       * const, not var, and querySelector rather than getElementById.
       *
       * The guard below narrows these to non-null, but TypeScript only carries a
       * narrowing into a nested function body for const bindings - a var could be
       * reassigned at any point, so open() and setCount() would each see them as
       * possibly null and astro check failed on it. Typing source as a
       * template is what gives it .content at all; getElementById returns
       * HTMLElement, which has no such property.
       */
      const archive = document.querySelector('#blog-archive');
      const source = document.querySelector<HTMLTemplateElement>('#blog-archive-src');
      const button = document.querySelector('#blog-more');
      if (!archive || !source || !button) return;

      var total = Number(archive.getAttribute('data-total') || 0);
      var shown = Number(archive.getAttribute('data-shown') || 0);
      var label = button.querySelector('[data-blog-more-label]');
      var count = document.querySelector('[data-blog-count]');

      function remember() {
        try {
          window.localStorage.setItem(KEY, '1');
        } catch (e) {
          /* storage blocked - the button still works, it just will not persist */
        }
      }

      function wasOpened() {
        try {
          return window.localStorage.getItem(KEY) === '1';
        } catch (e) {
          return false;
        }
      }

      function setCount(all: boolean) {
        if (!count) return;
        count.textContent = all
          ? 'Showing all ' + total + ' articles, newest first.'
          : 'Showing the ' + shown + ' newest of ' + total + ' articles.';
      }

      /*
       * A const function expression rather than a declaration. TypeScript will
       * not carry the guard's narrowing into a hoisted function declaration,
       * because in principle it could be called before the guard runs; a const
       * arrow cannot, so the non-null types survive into this body.
       */
      const open = function (rememberIt: boolean) {
        archive.appendChild(source.content.cloneNode(true));
        button.setAttribute('aria-expanded', 'true');
        if (label) label.textContent = 'Showing all articles';
        setCount(true);
        if (rememberIt) remember();
        button.remove();
      }

      // Somebody who has opened it before should not meet the wall again.
      if (wasOpened()) {
        open(false);
        return;
      }

      button.addEventListener('click', function () {
        open(true);
      });
    })();
  </script>
</BaseLayout>
