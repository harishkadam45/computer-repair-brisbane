---
/**
 * Region pages (e.g. /service-area/ipswich-west-moreton/).
 *
 * One page per region rather than per suburb. The legacy site had no region
 * pages at all, so these are new URLs; they exist to give the 666-suburb list
 * some topical grouping and to catch searches like "computer repairs Ipswich"
 * that a suburb page for a specific suburb would not satisfy.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import PageHero from '../../../components/PageHero.astro';
import CallToAction from '../../../components/CallToAction.astro';
import { site } from '../../../data/site';
import { families } from '../../../data/services';
import { suburbsByRegion } from '../../../lib/suburbs';
import { regionSlug, liveSuburbUrl } from '../../../lib/suburb-url.mjs';
import { formatInline } from '../../../lib/seo';
import * as schema from '../../../lib/schema';

export const getStaticPaths: GetStaticPaths = () =>
  suburbsByRegion().map((r) => ({
    params: { region: regionSlug(r.region) },
    props: { regionName: r.region },
  }));

const { regionName } = Astro.props;
const region = suburbsByRegion().find((r) => r.region === regionName)!;

/** This page links every suburb in the computer-repairs family. */
const computerRepairs = families.find((f) => f.slug === 'computer-repairs')!;

const path = `/service-area/${regionSlug(region.region)}/`;
const title = `Computer Repairs ${region.region} | Flat $${site.pricing.flatRate}`;
const description =
  `Computer, laptop and Mac repairs across ${region.suburbs.length} suburbs in ` +
  `${region.region}, including ${region.suburbs.slice(0, 3).map((s) => s.name).join(', ')} and ` +
  `surrounding areas. Flat $${site.pricing.flatRate}, travel included. Call ${site.phone.display}.`;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Service area', path: '/service-area/' },
  { name: region.region, path },
];

const others = suburbsByRegion().filter((r) => r.region !== region.region);

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.itemList({
      name: `Suburbs in ${region.region}`,
      path,
      items: region.suburbs.map((s) => ({ name: s.name, path: liveSuburbUrl(computerRepairs, s) })),
    }),
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={jsonLd}
  brandInTitle={false}
>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow={`${region.suburbs.length} suburbs · travel included`}
    title={`Computer repairs in ${region.region}`}
    intro={[
      formatInline(
        `Flat $${site.pricing.flatRate} for the first hour anywhere in ${region.region}, with ` +
          `travel included and no surcharge for the distance. Same technician, same rate, whether ` +
          `it is a five-minute fix or a full afternoon.`,
      ),
    ]}
    icon="network"
    badges={[
      `Flat $${site.pricing.flatRate} rate`,
      'Travel included',
      'No travel surcharge',
      '7 days a week',
    ]}
    facts={[
      { label: 'Suburbs', value: String(region.suburbs.length) },
      { label: 'Call-out', value: '$0' },
      { label: 'Weekend', value: 'No surcharge' },
    ]}
  />

  <div class="container-page space-y-14 py-14 sm:space-y-16 sm:py-20">
    <section aria-labelledby="suburbs-heading">
      <h2 id="suburbs-heading" class="text-h2">
        Suburbs in {region.region}
      </h2>
      <p class="mt-3 max-w-2xl text-lead text-ink-600">
        Every suburb below has its own page, with the faults common to the area and pricing for
        that specific job.
      </p>
      <ul class="mt-7 grid gap-x-6 gap-y-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {
          region.suburbs.map((s) => (
            <li>
              <a
                href={liveSuburbUrl(computerRepairs, s)}
                class="text-ink-700 underline-offset-2 hover:text-brand-300 hover:underline"
              >
                Computer repairs {s.name}
                {s.postcode && <span class="ml-1.5 text-sm text-ink-400">{s.postcode}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="services-heading" class="border-t border-ink-100 pt-14">
      <h2 id="services-heading" class="text-h2">Services in {region.region}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          families.map((f) => (
            <a
              href={`/${f.slug}/`}
              class="rounded-card border border-ink-200 bg-white/[0.06] p-5 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lift"
            >
              <h3 class="text-[0.98rem] font-extrabold text-brand-300">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{f.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="other-regions-heading" class="border-t border-ink-100 pt-14">
      <h2 id="other-regions-heading" class="text-h2">Other areas</h2>
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          others.map((r) => (
            <li>
              <a
                href={`/service-area/${regionSlug(r.region)}/`}
                class="inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white/[0.06] px-4 py-2.5 text-sm font-semibold text-ink-700 transition hover:border-brand-300 hover:bg-brand-500/10"
              >
                {r.region}
                <span class="rounded-full bg-ink-100 px-1.5 py-0.5 text-xs font-semibold text-ink-500">
                  {r.suburbs.length}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="container-page pb-16 sm:pb-20">
    <CallToAction
      title={`Need a repair in ${region.region}?`}
      body="Call with your suburb and a description of the problem. You will get a straight answer on whether I can fix it and what it will cost."
    />
  </div>
</BaseLayout>
