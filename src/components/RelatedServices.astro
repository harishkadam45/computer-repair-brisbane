---
/**
 * Internal-link block. Resolves a list of service slugs into cards, and is the
 * mechanism that keeps the ~1,650 suburb pages from being orphaned - every one
 * of them links out to its family hub, its sibling service, and the service
 * area index.
 */
import { serviceBySlug, familyBySlug } from '../data/services';
import ServiceCard from './ServiceCard.astro';

interface Props {
  slugs: string[];
  title?: string;
  intro?: string;
}

const { slugs = [], title = 'Related services', intro } = Astro.props;

/**
 * Unknown slugs are dropped rather than rendered as broken links, but they are
 * also reported. A typo in a `related` array otherwise fails silently: the
 * page still builds, it just quietly links to four instead of five services,
 * and nobody notices until the internal-link audit a year later.
 */
const unknown = slugs.filter((slug) => !serviceBySlug.has(slug) && !familyBySlug.has(slug));
if (unknown.length > 0) {
  console.warn(`[related-services] unknown slugs ignored: ${unknown.join(', ')}`);
}

const resolved = slugs
  .map((slug) => {
    const service = serviceBySlug.get(slug);
    if (service) {
      return {
        href: `/${service.slug}/`,
        title: service.title,
        summary: service.summary,
        icon: service.icon,
        price: service.price,
      };
    }
    const family = familyBySlug.get(slug);
    if (family) {
      return {
        href: `/${family.slug}/`,
        title: family.title,
        summary: family.summary,
        icon: family.icon,
      };
    }
    return null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);
---

{
  resolved.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-h2">
        {title}
      </h2>
      {intro && <p class="mt-3 max-w-2xl text-lead text-ink-600">{intro}</p>}
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {resolved.map((r) => (
          <ServiceCard
            href={r.href}
            title={r.title}
            summary={r.summary}
            icon={r.icon}
            price={r.price}
            pricePrefix={r.price ? 'from' : undefined}
          />
        ))}
      </div>
    </section>
  )
}
