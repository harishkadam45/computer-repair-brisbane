---
/**
 * Blog index at /blog/.
 *
 * 110 migrated posts, ~98,000 words, published between 2017 and now. The index
 * is the hub that keeps them from becoming orphans: every post links here, and
 * every post is reachable from the header.
 *
 * Grouped by year rather than paginated. A 110-item single column is long but
 * it is scannable, and year headings give the archive topical structure that a
 * flat "load more" list would not.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CallToAction from '../../components/CallToAction.astro';
import { site } from '../../data/site';
import { posts, formatDate, isoDate } from '../../data/posts';
import { clampDescription } from '../../lib/seo';
import * as schema from '../../lib/schema';

const path = '/blog/';
const title = `Computer Repair Blog | ${posts.length} Articles | ${site.name}`;
const description = clampDescription(
  `Practical computer repair advice from ${site.technician.name} in Brisbane: what's actually ` +
    `wrong with your machine, what it costs to fix, and when replacing it makes more sense. ` +
    `${posts.length} articles.`,
);

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];

/** Newest first, grouped into years for scannability. */
const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = post.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));

/** The three most recent posts get a featured slot above the archive. */
const featured = posts.slice(0, 3);

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.itemList({
      name: 'Computer repair articles',
      path,
      items: posts.map((p) => ({ name: p.title, path: p.path })),
    }),
  ],
});
---

<BaseLayout title={title} description={description} path={path} schema={jsonLd}>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow={`${posts.length} articles · ${Math.round(posts.reduce((n, p) => n + p.words, 0) / 1000)}k words`}
    title="Computer repair advice"
    intro={[
      `What people ask me most, written up properly. What is actually wrong with the machine, what it ` +
        `costs to fix, and the cases where replacing it is the sensible call.`,
      `Everything here is written from the bench rather than assembled from a list of search terms - ` +
        `if a fix is not worth doing I say so.`,
    ]}
    icon="support"
  />

  <div class="container-page space-y-14 py-14 sm:space-y-16 sm:py-20">
    {
      featured.length > 0 && (
        <section aria-labelledby="b-latest">
          <h2 id="b-latest" class="text-h2">Latest</h2>
          <div class="mt-6 grid gap-5 lg:grid-cols-3">
            {featured.map((p) => (
              <a
                href={p.path}
                class="group flex flex-col rounded-card border border-ink-200 bg-white/[0.06] p-6 transition hover:border-brand-300"
              >
                <time class="text-sm text-ink-500" datetime={isoDate(p.date)}>
                  {formatDate(p.date)}
                </time>
                <h3 class="mt-2 text-h3 group-hover:text-brand-300">{p.title}</h3>
                <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">{p.excerpt}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-300">
                  Read
                  <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section aria-labelledby="b-archive">
      <h2 id="b-archive" class="text-h2">Archive</h2>
      <div class="mt-8 space-y-10">
        {
          years.map(([year, list]) => (
            <div>
              <h3 class="flex items-baseline gap-3 text-sm font-bold tracking-wide text-ink-900 uppercase">
                {year}
                <span class="text-xs font-semibold tracking-normal text-ink-500 normal-case">
                  {list.length} article{list.length === 1 ? '' : 's'}
                </span>
              </h3>
              <ul class="mt-4 divide-y divide-ink-100 border-t border-ink-100">
                {list.map((p) => (
                  <li>
                    <a
                      href={p.path}
                      class="group flex flex-col gap-1 py-4 transition sm:flex-row sm:items-baseline sm:gap-5"
                    >
                      <time
                        class="shrink-0 text-sm text-ink-500 sm:w-28"
                        datetime={isoDate(p.date)}
                      >
                        {formatDate(p.date).replace(/ \d{4}$/, '')}
                      </time>
                      <span>
                        <span class="font-semibold text-ink-900 group-hover:text-brand-300">
                          {p.title}
                        </span>
                        <span class="mt-1 block text-[0.92rem] leading-relaxed text-ink-500">
                          {p.excerpt}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <div class="container-page pb-14 sm:pb-20">
    <CallToAction
      title="Rather just have it fixed?"
      body={`Flat $${site.pricing.flatRate} for the first hour, no call-out fee, and no surcharge at the weekend. Call ${site.phone.display} and describe the fault - you will get a straight answer on cost.`}
    />
  </div>
</BaseLayout>
