---
/**
 * Sticky mobile action bar.
 *
 * Most visitors to this site are on a phone with a broken computer, so the two
 * actions that matter - call and quote - are pinned to the bottom of the
 * viewport on small screens. Pure CSS, no JS, and it is hidden from the
 * accessibility tree as a duplicate of the header actions.
 */
import { site } from '../data/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-200 bg-white/97 backdrop-blur-sm sm:hidden"
  aria-hidden="true"
>
  <div class="grid grid-cols-2">
    <a
      href={site.phone.href}
      tabindex="-1"
      class="flex items-center justify-center gap-2 border-r border-ink-200 px-4 py-3.5 text-[0.95rem] font-bold text-brand-700"
    >
      <svg class="size-4.5" viewBox="0 0 20 20" fill="currentColor">
        <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.1a.75.75 0 0 1 .74.64l.5 2.5a.75.75 0 0 1-.19.7L5.4 7.3a12 12 0 0 0 7.3 7.3l1.46-1.25a.75.75 0 0 1 .7-.19l2.5.5a.75.75 0 0 1 .64.74v2.1a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 2 5v-1.5Z"></path>
      </svg>
      Call now
    </a>
    <a
      href={site.quoteForm.url}
      tabindex="-1"
      rel="noopener"
      target="_blank"
      class="flex items-center justify-center bg-brand-500 px-4 py-3.5 text-[0.95rem] font-bold text-white"
    >
      Free quote
    </a>
  </div>
  <!-- Spacer so the footer is not permanently covered. -->
  <div class="h-1"></div>
</div>
