---
/**
 * Site header.
 *
 * The nav is rendered server-side as real links - no JavaScript needed for
 * anything a crawler or a crawler-less reader has to see. The only script on
 * the page is a small disclosure toggle for the mobile menu, and it is inlined
 * and deferred.
 */
import { site } from '../data/site';
import { families, serviceBySlug, serviceGroups } from '../data/services';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;

/** Grouped for the dropdown, minus any slug that no longer resolves. */
const megaGroups = serviceGroups
  .map((g) => ({
    heading: g.heading,
    items: g.slugs.map((slug) => serviceBySlug.get(slug)).filter((s) => s !== undefined),
  }))
  .filter((g) => g.items.length > 0);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-ink-100 bg-white/95 backdrop-blur-sm">
  <!-- Utility bar: the two things people need on every page, above the fold. -->
  <div class="hidden border-b border-ink-100 bg-ink-50 sm:block">
    <div class="container-page flex h-9 items-center justify-between text-sm">
      <p class="text-ink-600">
        Flat <strong class="font-semibold text-ink-900">${site.pricing.flatRate}</strong> rate ·
        no call-out fee · 7 days a week
      </p>
      <div class="flex items-center gap-4">
        <a
          href={site.phone.href}
          class="font-semibold text-brand-600 transition hover:text-brand-700"
        >
          <span aria-hidden="true">📞</span>
          <span class="sr-only">Call </span>{site.phone.display}
        </a>
        <a href={site.quoteForm.url} class="text-ink-600 transition hover:text-brand-700">
          Get a quote
        </a>
      </div>
    </div>
  </div>

  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${site.name} home`}>
      <img
        src={site.logo}
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-xl"
        loading="eager"
        decoding="async"
      />
      <span class="flex flex-col leading-none">
        <span class="text-[0.98rem] font-extrabold tracking-tight text-ink-900 sm:text-lg">
          {site.name}
        </span>
        <span class="mt-0.5 text-[0.68rem] font-medium tracking-wide text-ink-500 uppercase">
          {site.tagline}
        </span>
      </span>
    </a>

    <!-- Search. Real GET form to /search/ so it works with JS disabled. -->
    <form
      action="/search/"
      method="get"
      role="search"
      class="relative hidden w-full max-w-xs lg:block"
      data-search-form
    >
      <label for="nav-search" class="sr-only">Search services, suburbs and articles</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-ink-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"><path
            fill-rule="evenodd"
            d="M9 3.5a5.5 5.5 0 1 0 3.4 9.84l3.63 3.63a1 1 0 1 0 1.41-1.41l-3.63-3.63A5.5 5.5 0 0 0 9 3.5ZM5 9a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z"
            clip-rule="evenodd"></path></svg>
        <input
          id="nav-search"
          name="q"
          type="search"
          placeholder="Search services…"
          autocomplete="off"
          class="w-full rounded-xl border border-ink-200 bg-ink-50 py-2.5 pr-3 pl-9 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:bg-white focus:outline-none"
          aria-expanded="false"
          aria-controls="nav-search-results"
          aria-autocomplete="list"
        />
      </div>
      <!-- Toggled via the hidden *attribute* by search.js, so no `hidden`
           utility class here - it would force display:none and win. -->
      <div
        id="nav-search-results"
        class="absolute top-full right-0 left-0 z-50 mt-2 max-h-[min(22rem,55vh)] overflow-y-auto overscroll-contain rounded-xl border border-ink-100 bg-white shadow-lift"
        data-search-results
        hidden
      >
      </div>
    </form>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <a
        href="/"
        class:list={[
          'rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
          path === '/' ? 'text-brand-700' : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900',
        ]}
        aria-current={path === '/' ? 'page' : undefined}
      >
        Home
      </a>

      <!-- Services has a dropdown of the service families. -->
      <div class="group relative">
        <a
          href="/services/"
          class:list={[
            'flex items-center gap-1.5 rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
            isActive('/services/') || isActive('/service-area/')
              ? 'text-brand-700'
              : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900',
          ]}
          aria-haspopup="true"
        >
          Services
          <svg
            class="size-3.5 text-ink-400 transition group-hover:rotate-180"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"><path
              fill-rule="evenodd"
              d="M5.2 7.4a1 1 0 0 1 1.4 0L10 10.8l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.8a1 1 0 0 1 0-1.4Z"
              clip-rule="evenodd"></path></svg>
        </a>
        <div
          class="invisible fixed top-20 right-4 left-4 mx-auto w-auto max-w-[58rem] rounded-2xl border border-ink-100 bg-white p-5 opacity-0 shadow-lift transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
            <div>
              <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                By device
              </p>
              <ul class="grid grid-cols-2 gap-1">
                {
                  families.map((f) => (
                    <li>
                      <a
                        href={`/${f.slug}/`}
                        class="block rounded-xl px-3 py-2.5 transition hover:bg-brand-50"
                      >
                        <span class="block text-sm font-semibold text-ink-900">{f.title}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-ink-500">
                          {f.summary.slice(0, 68)}…
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <p class="mt-5 border-t border-ink-100 px-1 pt-4 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                What we fix
              </p>
              <div class="grid gap-x-4 gap-y-4 sm:grid-cols-3">
                {
                  megaGroups.map((g) => (
                    <div>
                      <h3 class="px-3 pb-1 text-[0.8rem] font-bold text-ink-900">{g.heading}</h3>
                      <ul>
                        {g.items.map((s) => (
                          <li>
                            <a
                              href={`/${s.slug}/`}
                              class="block rounded-lg px-3 py-1.5 text-sm text-ink-700 transition hover:bg-brand-50 hover:text-brand-700"
                            >
                              {s.shortTitle}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="border-t border-ink-100 pt-4 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-6">
              <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
                Start here
              </p>
              <ul class="space-y-1">
                {
                  [
                    { label: `Call ${site.phone.display}`, href: site.phone.href, note: 'Fastest way to get it fixed.' },
                    { label: 'Request a quote', href: site.quoteForm.url, note: 'If you would rather not phone.' },
                    { label: 'See pricing', href: '/pricing/', note: `Flat $${site.pricing.flatRate}, no call-out fee.` },
                  ].map((t) => (
                    <li>
                      <a
                        href={t.href}
                        rel={t.href.startsWith('http') ? 'noopener' : undefined}
                        target={t.href.startsWith('http') ? '_blank' : undefined}
                        class="block rounded-xl px-3 py-2.5 transition hover:bg-brand-50"
                      >
                        <span class="block text-sm font-semibold text-brand-700">{t.label}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-ink-500">{t.note}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a
                href="/services/"
                class="mt-3 block rounded-xl bg-ink-900 px-3 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-ink-800"
              >
                All services →
              </a>
            </div>
          </div>
        </div>
      </div>

      {
        nav
          .filter((item) => !['/', '/services/'].includes(item.href))
          .map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-[0.95rem] font-semibold transition',
              isActive(item.href)
                ? 'text-brand-700'
                : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.phone.href}
        class="hidden items-center gap-2 rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white shadow-cta transition hover:bg-brand-600 sm:flex"
      >
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.1a.75.75 0 0 1 .74.64l.5 2.5a.75.75 0 0 1-.19.7L5.4 7.3a12 12 0 0 0 7.3 7.3l1.46-1.25a.75.75 0 0 1 .7-.19l2.5.5a.75.75 0 0 1 .64.74v2.1a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 2 5v-1.5Z"
          ></path>
        </svg>
        {site.phone.display}
      </a>

      <button
        type="button"
        class="flex size-11 items-center justify-center rounded-xl border border-ink-200 text-ink-700 transition hover:bg-ink-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile search. Same form/action as desktop so it degrades identically. -->
  <div class="border-b border-ink-100 bg-white lg:hidden">
    <form
      action="/search/"
      method="get"
      role="search"
      class="container-page py-3"
      data-search-form
    >
      <label for="mobile-search" class="sr-only">Search services</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-ink-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"><path
            fill-rule="evenodd"
            d="M9 3.5a5.5 5.5 0 1 0 3.4 9.84l3.63 3.63a1 1 0 1 0 1.41-1.41l-3.63-3.63A5.5 5.5 0 0 0 9 3.5ZM5 9a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z"
            clip-rule="evenodd"></path></svg>
        <input
          id="mobile-search"
          name="q"
          type="search"
          placeholder="Search services…"
          autocomplete="off"
          class="w-full rounded-xl border border-ink-200 bg-ink-50 py-2.5 pr-3 pl-9 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-400 focus:bg-white focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-search-results"
          aria-autocomplete="list"
        />
      </div>
      <!-- Same as above: hidden attribute only, no `hidden` utility class. -->
      <div
        id="mobile-search-results"
        class="mt-2 max-h-[min(22rem,50vh)] overflow-y-auto overscroll-contain rounded-xl border border-ink-100 bg-white shadow-lift"
        data-search-results
        hidden
      >
      </div>
    </form>
  </div>

  <!-- Mobile nav. Hidden with [hidden] so it is genuinely absent from the a11y tree. -->
  <div id="mobile-nav" class="hidden border-t border-ink-100 bg-white lg:hidden" data-menu>
    <nav class="container-page py-4" aria-label="Mobile">
      <p class="px-1 pb-2 text-xs font-semibold tracking-wide text-ink-400 uppercase">
        By device
      </p>
      <ul class="grid grid-cols-2 gap-1.5">
        {
          families.map((f) => (
            <li>
              <a
                href={`/${f.slug}/`}
                class="block rounded-lg bg-brand-50 px-3 py-2.5 text-sm font-semibold text-brand-800"
              >
                {f.title}
              </a>
            </li>
          ))
        }
      </ul>
      {
        megaGroups.map((g) => (
          <div class="mt-4">
            <h3 class="px-1 pb-1 text-[0.8rem] font-bold text-ink-900">{g.heading}</h3>
            <ul class="grid grid-cols-2 gap-x-2 gap-y-0.5">
              {g.items.map((s) => (
                <li>
                  <a
                    href={`/${s.slug}/`}
                    class="flex min-h-11 items-center rounded-lg px-3 py-2.5 text-sm text-ink-700 transition hover:bg-brand-50 hover:text-brand-700"
                  >
                    {s.shortTitle}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <a
        href="/services/"
        class="mt-2 block rounded-lg bg-ink-900 px-3 py-2.5 text-center text-sm font-semibold text-white"
      >
        All services
      </a>
      <ul class="mt-4 space-y-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg px-3 py-2.5 text-[0.95rem] font-semibold',
                  isActive(item.href) ? 'bg-ink-50 text-brand-700' : 'text-ink-800',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={site.quoteForm.url}
        class="mt-4 block rounded-xl bg-brand-500 px-4 py-3 text-center text-sm font-semibold text-white"
      >
        Get a free quote
      </a>
      <a
        href={site.phone.href}
        class="mt-2 block rounded-xl border-2 border-brand-500 px-4 py-3 text-center text-sm font-bold text-brand-700"
      >
        Call {site.phone.display}
      </a>
    </nav>
  </div>
</header>

<!-- Lives in public/scripts/ because it is a plain IIFE with no imports, so
     it needs no bundling - and every page shares one copy. -->
<script src="/scripts/search.js" defer></script>

<script is:inline>
  // Progressive enhancement only: the nav is a plain <nav> with real links
  // before this runs. No framework, no hydration, ~15 lines.
  (function () {
    var toggle = document.querySelector('[data-menu-toggle]');
    var menu = document.querySelector('[data-menu]');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
    });
  })();
</script>
