---
/**
 * Site footer.
 *
 * Carries the internal-link weight for the suburb pages: every service family
 * links to its hub, the hub links back, and the service-area page is linked
 * from the primary nav on every template.
 *
 * Icons are the real brand marks - Simple Icons for the social pair, Material
 * for phone/email/location - not generic stand-ins, so the Facebook glyph is
 * the Facebook glyph and the X glyph is X.
 *
 * The knock-out icons carry fill-rule="evenodd" on purpose. Each is two
 * subpaths that overlap: a solid shape with its detail removed. Under the
 * default nonzero rule the second subpath winds the same way and simply fills
 * in, so the detail vanishes. That is not hypothetical - the hand-rolled
 * envelope that used to sit here rendered as a solid rectangle and the clock
 * as a filled disc with a slit, because both relied on winding nobody checked.
 * evenodd makes the cut-out appear regardless of subpath direction. The clock
 * depends on it most: under nonzero it is a plain orange circle with no hands.
 */
import { site } from '../data/site';
import { families, services } from '../data/services';

/** pc-repairs-brisbane is a suburb-matrix page, not a service; it has its own link above. */
const serviceLinks = services.filter((s) => s.slug !== 'pc-repairs-brisbane');
const year = new Date().getFullYear();
---

<footer class="site-footer mt-10 border-t border-white/15 bg-black text-white sm:mt-24">
  <div class="container-page py-14">
    {/*
      Flex with space-between, not a grid of fixed column widths.

      Equal gaps in the markup are not equal gaps on screen. The previous
      grid gave every column the same 48px gap, but the columns were 280 /
      178 / 308 / 178px wide while their text only needed 280 / 167 / 282 /
      159. That slack sat inside the columns, so the visible space between
      Repairs and Services was much smaller than between Services and
      Company. Equal column gaps with unequal content cannot look even.

      Here each block is only as wide as its own content (the links are
      nowrap, so a block measures to its longest label) and the leftover
      width is split equally between the three spaces. At 1280 that is
      1088 - 889 = 199px over three gaps, so all three render at 66px.

      flex-wrap is what keeps that safe. Content-sized nowrap blocks cannot
      shrink, so under larger text they overflowed the page sideways - 247px
      of it at 1024px with 125% text. Wrapping drops a block onto a second
      line instead of pushing the layout off screen, and justify-between
      still splits each line's leftover evenly. The gap floor is 16px rather
      than 24px for one specific reason: at exactly 1024px the four blocks
      need 889px of the 960px available, which leaves 23.6px per gap. A 24px
      floor is a hair too big and dropped the last block onto a second line
      for a single pixel of shortfall.
    */}
    <div
      class="flex flex-col gap-10 lg:flex-row lg:flex-wrap lg:justify-between lg:gap-x-4 lg:gap-y-10"
    >
      <!-- Brand + NAP -->
      {/*
        max-w, not a fixed w. A fixed width here was measured in rem, so it
        grew with the user's text size and dragged the footer into horizontal
        overflow at 150%. A max-width caps this block at its 280px reading
        width while still letting flex shrink it when the row runs out of
        room, which is what keeps the text zoom-safe.
      */}
      <div class="min-w-0 max-w-[17.5rem]">
        <div class="flex items-center gap-2.5">
          <img src={site.logo} alt="" width="40" height="40" class="size-10 rounded-xl" loading="lazy" decoding="async" />
          <span class="flex flex-col leading-none">
            <span class="text-lg font-extrabold tracking-tight text-white">{site.name}</span>
            <span class="mt-0.5 text-[0.68rem] font-medium tracking-wide text-white/60 uppercase">
              {site.tagline}
            </span>
          </span>
        </div>
        {/*
          max-w-sm is load-bearing here, not decoration. As a flex item this
          paragraph would otherwise resolve to max-content and stretch the
          brand block across most of the footer, leaving the three spaces
          crowded to one side.
        */}
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/75">
          {site.technician.name} is a {site.technician.credential} ex-IBM help desk technician working
          alone across {site.serviceAreas.join(', ')}. One flat rate, no call-out fee, no weekend
          surcharge, and if it cannot be fixed you do not pay.
        </p>

        <div class="mt-6 space-y-2.5 text-sm">
          <a
            href={site.phone.href}
            class="flex items-center gap-2.5 font-bold text-brand-400 transition hover:text-brand-300"
          >
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C9.39 21 2 14.61 2 6c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path>
            </svg>
            {site.phone.display}
          </a>
          <a
            href={site.email.href}
            class="flex items-center gap-2.5 break-all text-white/75 transition hover:text-brand-400"
          >
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
            </svg>
            {site.email.display}
          </a>
          <p class="flex items-start gap-2.5 text-white/75">
            <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 8.5c0 5.25 7 13 7 13s7-7.75 7-13C19 5.13 15.87 2 12 2zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"></path>
            </svg>
            <span>Mobile service across {site.serviceAreas.join(', ')} and surrounding suburbs</span>
          </p>
          <p class="flex items-start gap-2.5 text-white/75">
            <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
              <path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm-1.5 3h3v5.5h4v3h-7Z"></path>
            </svg>
            <span>{site.hours.note}</span>
          </p>
        </div>
      </div>

      <!-- Service families + core services -->
      <nav class="min-w-0" aria-labelledby="f-services">
        <h2 id="f-services" class="text-left text-sm font-bold tracking-wide text-white uppercase lg:text-center">
          Repairs
        </h2>
        <ul class="mt-4 space-y-2.5 text-left text-sm lg:text-center">
          {
            families.map((f) => (
              <li>
                <a href={`/${f.slug}/`} class="text-white/75 transition hover:text-brand-400">
                  {f.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/pc-repairs-brisbane/" class="text-white/75 transition hover:text-brand-400">
              Computer Repairs Brisbane
            </a>
          </li>
          <li>
            <a href="/service-area/" class="text-white/75 transition hover:text-brand-400">
              All suburbs we service
            </a>
          </li>
          <li>
            <a href="/pricing/" class="text-white/75 transition hover:text-brand-400">Pricing</a>
          </li>
          <li>
            <a href="/quote/" class="text-white/75 transition hover:text-brand-400">Request a quote</a>
          </li>
        </ul>
      </nav>

      <nav class="min-w-0" aria-labelledby="f-services2">
        <h2
          id="f-services2"
          class="text-left text-sm font-bold tracking-wide text-white uppercase lg:text-center"
        >
          Services
        </h2>
        <ul class="mt-4 grid grid-cols-1 gap-x-4 gap-y-2.5 text-left text-sm sm:grid-cols-2 lg:text-center">
          {
            serviceLinks.map((s) => (
              <li>
                <a href={`/${s.slug}/`} class="text-white/75 transition hover:text-brand-400">
                  {s.shortTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Company + trust -->
      <div class="min-w-0">
        <h2 class="text-left text-sm font-bold tracking-wide text-white uppercase lg:text-center">Company</h2>
        <ul class="mt-4 space-y-2.5 text-left text-sm lg:text-center">
          <li><a href="/about/" class="text-white/75 transition hover:text-brand-400">About Robert</a></li>
          <li><a href="/testimonials/" class="text-white/75 transition hover:text-brand-400">Reviews</a></li>
          <li><a href="/blog/" class="text-white/75 transition hover:text-brand-400">Blog</a></li>
          <li><a href="/contact/" class="text-white/75 transition hover:text-brand-400">Contact</a></li>
          <li>
            <a href={site.reviews.url} rel="noopener nofollow" target="_blank" class="text-white/75 transition hover:text-brand-400">
              Word of Mouth reviews ↗
            </a>
          </li>
        </ul>

        <h2 class="mt-8 text-left text-sm font-bold tracking-wide text-white uppercase lg:text-center">Follow</h2>
        <div class="mt-4 flex justify-start gap-2 lg:justify-center">
          <a
            href={site.social.facebook}
            rel="noopener"
            target="_blank"
            class="flex size-9 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white transition hover:border-brand-400 hover:text-brand-400"
            aria-label="Facebook"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path></svg>
          </a>
          <a
            href={site.social.twitter}
            rel="noopener"
            target="_blank"
            class="flex size-9 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white transition hover:border-brand-400 hover:text-brand-400"
            aria-label="X (Twitter)"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.2 2h3.3l-7.3 8.3L23 22h-6.7l-5.2-6.8L5 22H1.7l7.8-8.9L1 2h6.9l4.7 6.2L18.2 2Zm-1.2 18h1.8L7.1 3.9H5.2L17 20Z"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p>
          © {year} {site.name}. Computer repairs in Brisbane, Logan and Ipswich. ABN details available
          on request.
        </p>
        <p class="mt-1.5">
          <a
            href={site.creditUrl}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-2 transition hover:text-brand-400"
          >
            {site.credit}
          </a>
        </p>
      </div>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>Servicing {site.serviceAreas.join(' · ')}</span>
        <a href="/sitemap-index.xml" class="underline underline-offset-2 hover:text-brand-400">Sitemap</a>
        <a href="/rss.xml" class="underline underline-offset-2 hover:text-brand-400">RSS</a>
      </p>
    </div>
  </div>
</footer>
