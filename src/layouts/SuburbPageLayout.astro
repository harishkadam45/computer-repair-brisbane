---
/**
 * Template for a per-suburb service page.
 *
 * There are ~1,650 of these and they share one layout, which is the point.
 * Each is a real page with its own URL, title, meta description, h1, body
 * copy driven by the suburb's own data (postcode, region, coordinates), a
 * ProfessionalService schema node scoped to that suburb, and real outbound
 * links to the family hub, the sibling families and the service-area index.
 *
 * The copy varies by service *and* by region - an Ipswich page should not read
 * like a Burleigh Heads page. Content is composed from the suburb record plus
 * the family record, with different paragraphs chosen per region, rather than
 * one template with the suburb name swapped in.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CopySection from '../components/CopySection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';
import type { ServiceFamily } from '../data/services';
import { families } from '../data/services';
import { getSuburb, postcodeLine, suburbs, type Suburb } from '../lib/suburbs';
import { liveSuburbUrl } from '../lib/suburb-url.mjs';
import { formatInline, fill } from '../lib/seo';
import * as schema from '../lib/schema';

interface Props {
  family: ServiceFamily;
  suburbKey: string;
}

const { family, suburbKey } = Astro.props;
const suburb = getSuburb(suburbKey);

if (!suburb) {
  throw new Error(`Unknown suburb key: "${suburbKey}". Run scripts/build-suburbs.mjs.`);
}

/**
 * Where this page lives: the oldest legacy slug if the suburb had one, otherwise
 * the canonical form. Read from the same helper getStaticPaths() used to decide
 * where to write the file, so the canonical tag, the breadcrumb, the JSON-LD
 * and the emitted path can never disagree. Redirects for the remaining legacy
 * variants are generated by scripts/build-redirects.mjs.
 */
const path = liveSuburbUrl(family, suburb);

const pc = postcodeLine(suburb);
const vars = {
  suburb: suburb.name,
  region: suburb.region,
  postcode: suburb.postcode ?? '',
  pc,
};

const title = `${family.title} ${suburb.name} | $${site.pricing.flatRate} Flat Rate`;
const description =
  `${family.title} in ${suburb.name}${suburb.postcode ? ` ${suburb.postcode}` : ''} and across ` +
  `${site.serviceAreas.join(', ')}. Flat $${site.pricing.flatRate}, no call-out fee, no weekend ` +
  `surcharge. Call ${site.phone.display}.`;

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: family.title, path: `/${family.slug}/` },
  { name: `${family.title} ${suburb.name}`, path },
];

/**
 * Region-specific framing. Picks the paragraph set that fits the geography so
 * pages in different areas are not the same page with a different noun.
 */
const regionCopy: Record<string, { lead: string[]; local: string[] }> = {
  'Ipswich & West Moreton': {
    lead: [
      'Ipswich and the western corridor is a good place to run a business out of a spare room, which means the computers here tend to do real work - invoicing, bookkeeping, online ordering, and a lot of printing. That is a different set of faults to a home machine, and usually a faster fix.',
    ],
    local: [
      'Common jobs out this way tend to be older business desktops that have slowed to the point of being unworkable, printers that have stopped talking to the network, and new machines that need setting up properly rather than left with the trial software still on them.',
      'If the machine is doing commercial work, GST is excluded from the rate. I will confirm that on the phone before I set off.',
    ],
  },
  'Logan & Beaudesert': {
    lead: [
      'Logan is a long way from the CBD and getting a technician out here used to mean a surcharge. It does not. The flat rate is the same in Logan as it is in the city, because the price has nothing to do with how far I drive.',
    ],
    local: [
      'Households out here are often the ones with the older family computer that has been quietly getting slower for four or five years. Adding memory and replacing the hard drive with an SSD usually makes an enormous difference, and it is the most common thing I recommend.',
      'I also do a lot of work for people working from home out here, which tends to mean networking, printers, and getting a new laptop set up properly rather than slowly learning to live with it.',
    ],
  },
  'Moreton Bay & Redcliffe': {
    lead: [
      'The northern corridor - North Lakes, Mango Hill, Deception Bay, Redcliffe, Caboolture and everywhere between - is a long trip and a lot of driving for a call-out. The flat rate is the same, and the call-out fee is nothing.',
    ],
    local: [
      'The machines I see most out here are laptops that have been knocked about by travel, and desktops that have been running in a garage or a spare room through several hot summers. Dust and heat are the usual culprits for the sudden failures.',
    ],
  },
  Redland: {
    lead: [
      'Redland - Redland Bay, Capalaba, Cleveland, Victoria Point and the bayside suburbs - has the same flat rate as everywhere else. No coastal surcharge, no call-out fee.',
    ],
    local: [
      'Laptops that live in a car or on a boat do not last, and that shows up here more than most areas. Salt air and heat are hard on screens, batteries and hinges.',
    ],
  },
  Gold: {
    lead: [
      'I service the northern Gold Coast as well as Brisbane, Logan and Ipswich, at the same flat rate. If you are south of the border near the Tweed, call and ask - I will tell you straight away if I cannot get to you.',
    ],
    local: [
      'Out this way the common jobs are the same: slow machines, cracked laptop screens, virus and pop-up cleanups, and new computer setups.',
    ],
  },
  Sunshine: {
    lead: [
      'I cover the Sunshine Coast as well as Brisbane. It is a longer drive, and it changes the flat rate not at all - there is no call-out fee and no surcharge for the distance.',
    ],
    local: [
      'A lot of the work out here is holiday-rental and home-office machines: getting a new laptop set up, keeping a family machine running, and cleaning out the pop-ups that come with whatever the kids have installed.',
    ],
  },
};

const generic = {
  lead: [
    `${suburb.name} is part of the area I cover, and the price is the same here as it is anywhere else in ${site.serviceAreas.join(', ')}. No call-out fee, no surcharge for the distance, and no surcharge at the weekend.`,
  ],
  local: [
    `Most jobs in ${suburb.name} are the usual ones: a machine that has got slower every year, something that will not boot, a laptop that overheats, a browser full of pop-ups, or a new computer that has not been set up properly yet.`,
  ],
};

const geoCopy = regionCopy[suburb.region] ?? generic;

const intro = [
  ...geoCopy.lead,
  family.intro[0],
  family.intro[1] ?? '',
].filter(Boolean);

const jsonLd = schema.graph({
  path,
  name: title,
  description,
  extra: [
    schema.breadcrumbList(trail),
    schema.localService({
      name: `${family.title} ${suburb.name}`,
      description,
      path,
      suburb: suburb.name,
      region: suburb.region,
      lat: suburb.lat,
      lon: suburb.lon,
    }),
    schema.faqPage(family.faqs),
  ],
});

/** The other three families, each linked with this suburb so the matrix closes. */
const siblings = families.filter((f) => f.slug !== family.slug);

/** Sibling suburb pages, so each page has genuine neighbours in the same area. */
const here = Number(suburb.postcode) || 0;
const postcodeDistance = (s: Suburb) => Math.abs((Number(s.postcode) || 0) - here);

const neighbours: Suburb[] = suburbs
  .filter((s) => s.region === suburb.region && s.key !== suburb.key)
  // Postcode proximity first - a 4004 next to 4005 is genuinely closer than a
  // 4004 next to 4300 - then alphabetical so the order is deterministic.
  .sort((a, b) => postcodeDistance(a) - postcodeDistance(b) || a.name.localeCompare(b.name))
  .slice(0, 8);

/** Resolve {suburb}/{region}/{postcode} in a section's copy for this page. */
const resolveSections = (list: ServiceFamily['sections']) =>
  list.map((s) => ({
    ...s,
    h: fill(s.h, vars),
    p: s.p?.map((p) => fill(p, vars)),
  }));

/** FAQ copy is family-wide, so answers mentioning "your area" get localised. */
const localisedFaqs = family.faqs.map((f) => ({
  q: fill(f.q, vars),
  a: fill(f.a, vars),
}));

const ctaTitle = `${family.title} in ${suburb.name} - call ${site.technician.name}.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={jsonLd}
  brandInTitle={false}
>
  <div class="container-page pt-5 sm:pt-6">
    <Breadcrumb trail={trail} />
  </div>

  <PageHero
    eyebrow={`${suburb.region}${suburb.postcode ? ` · ${suburb.postcode}` : ''}`}
    title={`${family.title} in ${suburb.name}`}
    intro={intro.map((p) => formatInline(p))}
    icon={family.icon}
    badges={[
      `Flat $${site.pricing.flatRate} rate`,
      'No call-out fee',
      '7 days a week',
      'Fixed or you do not pay',
    ]}
    facts={[
      { label: 'Turnaround', value: family.turnaround },
      ...(suburb.postcode ? [{ label: 'Postcode', value: suburb.postcode }] : []),
      { label: 'Same price as', value: `All ${site.serviceAreas.join(' & ')}` },
    ]}
  />

  <div class="container-page space-y-14 py-14 sm:space-y-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="space-y-12 lg:col-span-8 min-w-0">
        {/* Suburb-specific opening, so the top of the page is about this place. */}
        <section class="scroll-mt-24" aria-labelledby="s-local">
          <h2 id="s-local" class="text-h2">
            {fill(family.suburbSections?.[0]?.h ?? `${family.title} in {suburb}`, vars)}
          </h2>
          <div class="mt-4 max-w-3xl space-y-4 text-lead text-ink-700">
            {geoCopy.local.map((p) => <p set:html={formatInline(p)} />)}
            {
              family.suburbSections?.flatMap((s) => s.p ?? []).map((p) => (
                <p set:html={formatInline(fill(p, vars))} />
              ))
            }
          </div>
        </section>

        {resolveSections(family.sections).map((section, i) => (
          <CopySection section={section} id={`s-${i}`} />
        ))}
      </div>

      <aside class="lg:col-span-4 min-w-0">
        <div class="lg:sticky lg:top-28">
          <h2 class="text-sm font-bold tracking-wide text-ink-900 uppercase">At a glance</h2>
          <dl class="mt-4 space-y-3 rounded-card border border-ink-200 bg-white p-5 text-sm">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Suburb</dt>
              <dd class="font-semibold text-ink-900">{suburb.name}</dd>
            </div>
            {
              suburb.postcode && (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-ink-600">Postcode</dt>
                  <dd class="font-semibold text-ink-900">{suburb.postcode}</dd>
                </div>
              )
            }
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Area</dt>
              <dd class="text-right font-semibold text-ink-900">{suburb.region}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Onsite rate</dt>
              <dd class="font-semibold text-brand-700">${site.pricing.flatRate}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Call-out fee</dt>
              <dd class="font-semibold text-ink-900">$0</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-600">Availability</dt>
              <dd class="text-right font-semibold text-ink-900">7 days</dd>
            </div>
          </dl>

          {/* Closes the service matrix: the same suburb, other services. */}
          <h2 class="mt-8 text-sm font-bold tracking-wide text-ink-900 uppercase">
            Also in {suburb.name}
          </h2>
          <ul class="mt-4 space-y-2">
            {
              siblings.map((f) => (
                <li>
                  <a
                    href={liveSuburbUrl(f, suburb)}
                    class="flex items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-4 py-3.5 transition hover:border-brand-300 hover:bg-brand-50"
                  >
                    <span class="text-sm font-semibold text-ink-900">
                      {f.title} in {suburb.name}
                    </span>
                    <svg
                      class="size-4 shrink-0 text-ink-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M7.2 4.6a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4L11.5 10 7.2 5.6a1 1 0 0 1 0-1.4Z" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="mt-6 rounded-card border border-brand-200 bg-brand-50 p-5">
            <h2 class="text-sm font-bold text-brand-900">Near {suburb.name} too</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {
                neighbours.map((n) => (
                  <li>
                    <a
                      href={liveSuburbUrl(family, n)}
                      class="text-brand-800 underline-offset-2 hover:underline"
                    >
                      {family.title} {n.name}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a
              href="/service-area/"
              class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 hover:text-brand-800"
            >
              All {suburbs.length} suburbs we service
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M4 10a1 1 0 0 1 1-1h9.2l-3.6-3.6a1 1 0 1 1 1.4-1.4l5.3 5.3a1 1 0 0 1 0 1.4l-5.3 5.3a1 1 0 1 1-1.4-1.4L14.2 11H5a1 1 0 0 1-1-1Z" />
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <HowItWorks />
    <FaqList faqs={localisedFaqs} title={`${family.title} in ${suburb.name} - common questions`} />

    <CallToAction
      title={ctaTitle}
      body={`Flat $${site.pricing.flatRate} for the first hour, in 15-minute blocks after that. No call-out fee to ${suburb.name}, no weekend surcharge, and parts at cost. If it cannot be fixed you do not pay.`}
    />
  </div>
</BaseLayout>
